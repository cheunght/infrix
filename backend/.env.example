# Development example (SQLite). Do not copy these values into production.
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_HTTPS_MODE=direct
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_USE_X_FORWARDED_HOST=0
DB_ENGINE=sqlite

# Production values belong in /etc/infrix/infrix.env (or another secret store),
# never in the repository. The production deployment path requires all of these
# values and rejects SQLite, missing values, and unsupported DB_ENGINE values.
# DJANGO_ENV=production
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<random secret, at least 50 characters>
# DJANGO_ALLOWED_HOSTS=infrix.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://infrix.example.com
# DJANGO_HTTPS_MODE=proxy
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# DJANGO_SECURE_HSTS_PRELOAD=0
# DJANGO_USE_X_FORWARDED_HOST=0

# 登录安全：连续失败 5 次后锁定 15 分钟，窗口默认为 15 分钟
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
TZ=Asia/Shanghai

# LDAP / AD is configured from Organization & Permissions → LDAP / AD.
# This Fernet key protects LDAP bind and SMTP passwords stored in the database.
# Generate it outside the repository before saving either secret.
# INFRIX_CONFIG_ENCRYPTION_KEY=<base64-fernet-key>
# DB_ENGINE=mysql
# DB_NAME=infrix
# DB_USER=infrix
# DB_PASSWORD=<set outside the repository>
# DB_HOST=db.example.internal
# DB_PORT=3306
