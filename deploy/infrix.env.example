# Infrix production environment template.
#
# This file is a reference template only. Do not use it unchanged and do not
# commit a completed copy containing passwords or secrets. The installer uses
# /etc/infrix/infrix.env by default; keep the completed file outside the source
# tree with owner root:infrix and mode 640. Set ENV_FILE to an absolute path if
# a different location is required.
#
# For a fresh installation, DJANGO_SECRET_KEY may remain unset: install.sh
# generates it after confirming that the target database is empty. Existing
# installations must preserve their current DJANGO_SECRET_KEY.
# You may source this template after replacing its placeholders:
#   set -a; . deploy/infrix.env.example; set +a
# If both default TLS files already exist, install.sh configures local HTTPS on
# port 443 and redirects port 80. Override these paths when using another pair.
# TLS_CERT_FILE=/etc/pki/tls/certs/infrix.crt
# TLS_KEY_FILE=/etc/pki/tls/private/infrix.key

SERVER_NAME=infrix.example.com
DJANGO_ENV=production
DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<random-secret-at-least-50-characters>
DJANGO_ALLOWED_HOSTS=infrix.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://infrix.example.com
DJANGO_HTTPS_MODE=proxy
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_USE_X_FORWARDED_HOST=0

DB_ENGINE=mysql
DB_NAME=infrix
DB_USER=infrix
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Required before saving LDAP/AD or SMTP passwords from the administration UI.
# Generate a stable Fernet key outside the repository and back it up together
# with the database; changing it makes previously stored secrets unreadable.
INFRIX_CONFIG_ENCRYPTION_KEY=replace-with-base64-fernet-key

# Optional application defaults.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
TZ=Asia/Shanghai
